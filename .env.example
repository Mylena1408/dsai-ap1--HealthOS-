# Copie para .env (Windows: copy .env.example .env | Linux/macOS: cp .env.example .env).
# No Render, cadastre estas variáveis em Environment (ver render.yaml). Nunca versione o .env.

# Banco: SQLite local (arquivo na pasta do projeto). Para PostgreSQL use, por exemplo,
# postgresql://usuario:senha@host:5432/healthos — a aplicação converte para o driver asyncpg.
DATABASE_URL=sqlite:///./app.db

# Exigida pelo endpoint legado de login (apenas demonstração; troque o valor)
SECRET_KEY=troque-por-um-valor-qualquer
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=True

# Popula o banco com dados fictícios ao iniciar (idempotente)
SEED_DEMO_DATA=False

# Avaliação automática de alertas, em minutos (0 desliga)
ALERT_EVALUATION_INTERVAL_MINUTES=15

# Fuso dos horários do sistema. Linux/Render rodam em UTC; no Windows vale o fuso da máquina.
# Se o servidor não tiver a base de fusos, use a forma POSIX: APP_TIMEZONE=<-03>3
APP_TIMEZONE=America/Belem

# Assistente: demo (padrão, sem rede) ou anthropic (pip install -r requirements-ai.txt + ANTHROPIC_API_KEY)
AI_PROVIDER=demo
AI_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=   (defina só no .env local quando AI_PROVIDER=anthropic; nunca versione)
